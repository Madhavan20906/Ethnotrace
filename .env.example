# EthnoTrace Environment Configuration Template

# Database Persistence (Defaults to local SQLite if omitted)
# ETHNOTRACE_DATABASE_URL=postgresql://user:password@localhost:5432/ethnotrace_db

# Neo4j Graph Database (Optional: falls back to native high-performance graph store)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password

# Qdrant Semantic Retrieval (Optional: falls back to embedded semantic index)
# QDRANT_URL=http://localhost:6333

# Model / LLM Configuration (Configurable for local or remote providers)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Application Server
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=production
